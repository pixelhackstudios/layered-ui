        "layered-foundation"
      ],
      "files": [
        {
          "path": "registry/components/layered-button/LayeredButton.tsx",
          "target": "@ui/layered/LayeredButton.tsx",
          "type": "registry:ui"
        },
        {
          "path": "registry/components/layered-button/LayeredButton.css",
          "target": "@ui/layered/LayeredButton.css",
          "type": "registry:ui"
        }
      ]
    }
  ]
