{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "layered-ui",
  "homepage": "https://github.com/pixelhackstudios/layered-ui",
  "items": [
    {
      "name": "layered-foundation",
      "type": "registry:style",
      "title": "Layered UI Foundations",
      "description": "Base design tokens, physical casing depths, radii, motion rules, and dual theme maps.",
      "files": [
        {
          "path": "registry/foundations/layered-foundation/tokens.css",
          "target": "@styles/layered-ui/tokens.css",
          "type": "registry:style"
        }
      ]
    },
    {
      "name": "layered-button",
